# Vim/Neovim runtime files
*.swp
*.swo
*.swn
*~
.netrwhist

# Plugin directories (these should not be in version control).
# NOTE: patterns here are deliberately unanchored (no leading path), so they
# match at any depth. Patterns like ".config/nvim/lazy/" would be anchored to
# the repo root and could never match anything: this repo holds nvim/ and vim/,
# and the real plugin directories live under $HOME, not in the checkout.
bundle/
plugged/
lazy/
mason/

# Undo/backup/temporary files
undo/
backup/
tmp/
*.tmp

# gp.nvim context file (per-checkout, not shared)
.gp.md

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini

# IDE/Editor specific
.vscode/
.idea/
*.sublime-*

# Log files
*.log

# Compiled Lua files
*.luac

# Tag files
tags
tags.lock
tags.temp

# Local configuration (user-specific settings).
# Neither config sources these today; kept as a convention for local overrides.
local.vim
local.lua
